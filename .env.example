# Copy to .env (gitignored). Server-only: nothing here may be NEXT_PUBLIC_*
# except where marked.

# Supplier: LiteAPI (Nuitee). Sandbox key from the LiteAPI dashboard.
LITE_API_KEY=
# A sand_ key selects the sandbox; the production key goes in Vercel only.

# Jev: TypeSafe AI's decision model, asked FIRST on every chat message.
# Only the key is required; the endpoint defaults to api.typesafe.ai.
JEV_API_KEY=
# Optional overrides (defaults: public API, jev-latest, 800 ms, 0.85).
JEV_BASE_URL=
JEV_MODEL=
JEV_TIMEOUT_MS=
JEV_SETTLE_MIN=

# Anthropic: the fallback agent (Haiku) and the intent-scan extraction.
ANTHROPIC_API_KEY=
# Only for a key that is not scoped to a workspace (the API then answers 400).
ANTHROPIC_WORKSPACE_ID=
# Optional: another model from src/lib/models.ts, e.g. claude-haiku-4-5-20251001.
AGENT_MODEL=
# Optional spend caps over 24 hours, in cents (defaults 25 per search, 500 overall).
AI_SESSION_CAP_CENTS=
AI_DAILY_CAP_CENTS=

# Neon Postgres.
DATABASE_URL=

# Auth (NextAuth v5, email OTP) and Resend for the code email.
AUTH_SECRET=
RESEND_API_KEY=
# Optional. Default: Hotel finder <hotels@feraltravels.com> (the domain verified in Resend).
EMAIL_FROM=

# Google Maps: map panel + Places searchText for resolve_place. PAID calls.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

