# Copy to .env (gitignored). Server-only: nothing here may be NEXT_PUBLIC_*
# except where marked.

# Supplier: LiteAPI (Nuitee). Sandbox key from the LiteAPI dashboard.
LITEAPI_SANDBOX_KEY=
# Production key. Unset until the build is past step 9.
LITEAPI_PROD_KEY=

# Jev: the typed-decision server asked FIRST on every chat message.
# The base URL receives users' messages; it is a privacy boundary.
JEV_BASE_URL=
JEV_API_KEY=
# Optional overrides (defaults: typed-decisions, 800 ms, 0.85).
JEV_MODEL=
JEV_TIMEOUT_MS=
JEV_SETTLE_MIN=

# Anthropic: the fallback agent (Haiku) and the intent-scan extraction.
ANTHROPIC_API_KEY=

# Neon Postgres.
DATABASE_URL=

# Auth (NextAuth v5, email OTP) and Resend for the code email.
AUTH_SECRET=
RESEND_API_KEY=

# Google Maps: map panel + Places searchText for resolve_place. PAID calls.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
